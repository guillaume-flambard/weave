[Unit]
Description=weave-api (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/weave/deploy
ExecStart=/usr/bin/docker compose -f weave-api.compose.yml up -d --build
ExecStop=/usr/bin/docker compose -f weave-api.compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
